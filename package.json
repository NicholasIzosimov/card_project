{
  "name": "weightless-deck",
  "version": "0.1.0",
  "private": true,
  "description": "A 2D rigid-body card sandbox. Millimetres, grams, seconds.",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node tools/build-body.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && node test/physics.mjs && node test/smoke.mjs",
    "physics": "node test/physics.mjs",
    "physics:update": "node test/physics.mjs --update",
    "smoke": "node test/smoke.mjs"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "type": "module"
}
